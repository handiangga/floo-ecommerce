NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://USER:STRONG_PASSWORD@localhost:5432/floo_ecommerce
DATABASE_SSL=false
JWT_SECRET=replace_with_a_random_64_character_secret
JWT_EXPIRES_IN=7d
CRON_SECRET=replace_with_a_different_random_secret
INITIAL_OWNER_NAME=Floo Owner
INITIAL_OWNER_EMAIL=owner@floofashionn.com
INITIAL_OWNER_PHONE=081234567890
INITIAL_OWNER_PASSWORD=replace_with_a_strong_owner_password

CORS_ORIGINS=https://floofashionn.com,https://www.floofashionn.com
FRONTEND_URL=https://floofashionn.com

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_BUCKET=ecommerce

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.floofashionn.com/api/v1/customer-auth/google/callback

MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY

API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
ADMIN_AUTH_RATE_LIMIT_MAX=8
HEALTHCHECK_DB_TIMEOUT_MS=4000
